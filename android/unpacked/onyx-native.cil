; Onyx Essential offline image integration. Merge into a loaded policy file.
; This fragment requires the Xiaomi Onyx vendor labels; compile the full ROM.
(type onyx_daemon)
(type onyx_daemon_exec)
(type onyx_daemon_data_file)
(type onyx_app)
(type onyx_app_userfaultfd)
(typeattribute onyx_app_userfaultfd_others)
(typeattribute onyx_app_ptrace_forbidden)
(type sysfs_onyx_mali_devfreq)
(type sysfs_onyx_touch)
(type sysfs_onyx_subsystem)
(type sysfs_onyx_subsystem_floor)
(roletype object_r onyx_daemon)
(roletype object_r onyx_daemon_exec)
(roletype object_r onyx_daemon_data_file)
(roletype object_r onyx_app)
(roletype object_r onyx_app_userfaultfd)
(roletype object_r sysfs_onyx_mali_devfreq)
(roletype object_r sysfs_onyx_touch)
(roletype object_r sysfs_onyx_subsystem)
(roletype object_r sysfs_onyx_subsystem_floor)
(typeattributeset domain (onyx_daemon onyx_app))
(typeattributeset coredomain (onyx_daemon onyx_app))
(typeattributeset mlstrustedsubject (onyx_daemon))
(typeattributeset appdomain (onyx_app))
(typeattributeset untrusted_app_all (onyx_app))
(typeattributeset netdomain (onyx_app))
(typeattributeset exec_type (onyx_daemon_exec))
(typeattributeset file_type (onyx_daemon_exec onyx_daemon_data_file))
(typeattributeset system_file_type (onyx_daemon_exec))
(typeattributeset data_file_type (onyx_daemon_data_file))
(typeattributeset core_data_file_type (onyx_daemon_data_file))
(typeattributeset fs_type (sysfs_onyx_mali_devfreq sysfs_onyx_touch))
(typeattributeset sysfs_type (sysfs_onyx_mali_devfreq sysfs_onyx_touch))
(typeattributeset fs_type (sysfs_onyx_subsystem sysfs_onyx_subsystem_floor))
(typeattributeset sysfs_type (sysfs_onyx_subsystem sysfs_onyx_subsystem_floor))

; Equivalent app_domain essentials; Android's existing app rules still apply.
(typetransition onyx_app tmpfs file appdomain_tmpfs)
(allow onyx_app appdomain_tmpfs (file (execute getattr map read write ioctl)))
(allowx onyx_app appdomain_tmpfs (ioctl file ((range 0x7701 0x770b))))
(typetransition onyx_app onyx_app anon_inode "[userfaultfd]" onyx_app_userfaultfd)
(allow onyx_app onyx_app_userfaultfd (anon_inode (create ioctl read)))
(typeattributeset onyx_app_userfaultfd_others (and (domain) (not (onyx_app))))
(typeattributeset onyx_app_ptrace_forbidden (and (domain) (not (onyx_app crash_dump runas_app simpleperf))))
(neverallow onyx_app_userfaultfd_others onyx_app_userfaultfd (anon_inode (create ioctl read)))
(neverallow onyx_app_ptrace_forbidden onyx_app (process (ptrace)))

; Init startup, owned state and the certificate-bound app control socket.
(typetransition init onyx_daemon_exec process onyx_daemon)
(allow init onyx_daemon (process (transition rlimitinh siginh)))
(allow init onyx_daemon_exec (file (getattr open read execute map)))
(allow onyx_daemon onyx_daemon_exec (file (entrypoint getattr open read execute map)))
(allow onyx_app onyx_daemon (unix_stream_socket (connectto)))
(allow onyx_daemon self (unix_stream_socket (ioctl read write create getattr setattr lock append bind connect listen accept getopt setopt shutdown)))
(allow onyx_daemon self (capability (dac_override sys_admin sys_nice sys_ptrace)))
(allow onyx_daemon self (netlink_kobject_uevent_socket (create bind read getattr getopt setopt)))
(allow onyx_daemon onyx_daemon_data_file (dir (ioctl read write create getattr setattr lock rename add_name remove_name reparent search open rmdir)))
(allow onyx_daemon onyx_daemon_data_file (file (ioctl read write create getattr setattr lock append map unlink link rename open)))

; Framework commands, including output pipe/FD replies.
(allow onyx_daemon servicemanager (binder (call transfer)))
(allow servicemanager onyx_daemon (binder (call transfer)))
(allow servicemanager onyx_daemon (dir (search)))
(allow servicemanager onyx_daemon (file (read open)))
(allow servicemanager onyx_daemon (process (getattr)))
(allow onyx_daemon system_server (binder (call transfer)))
(allow system_server onyx_daemon (binder (transfer)))
(allow onyx_daemon system_server (fd (use)))
(allow system_server onyx_daemon (fd (use)))
(allow system_server onyx_daemon (fifo_file (write)))
(allow onyx_daemon display_service (service_manager (find)))
(allow onyx_daemon power_service (service_manager (find)))
(allow onyx_daemon settings_service (service_manager (find)))
(allow onyx_daemon window_service (service_manager (find)))
(allow onyx_daemon activity_service (service_manager (find)))
(allow onyx_daemon package_service (service_manager (find)))
; Passive foreground event stream for Per-App Controls.
(allow onyx_daemon logd (unix_stream_socket (connectto)))
(allow onyx_daemon logdr_socket (sock_file (read write open getattr)))
(allow onyx_daemon overlay_service (service_manager (find)))
(allow onyx_daemon system_file (file (getattr open read execute map execute_no_trans)))
(allow onyx_daemon toolbox_exec (file (getattr open read execute map execute_no_trans)))

; Hardware nodes. No generic sysfs file write permission.
(allow onyx_daemon sysfs (dir (search)))
; Battery class links need parent traversal before leaf permissions apply.
; No sysfs_batteryinfo file access is granted.
(allow onyx_daemon sysfs_batteryinfo (dir (search)))
(allow onyx_daemon sysfs_devices_system_cpu (dir (search getattr open read)))
(allow onyx_daemon sysfs_devices_system_cpu (file (read write getattr open ioctl lock map)))
(allow onyx_daemon sysfs_devices_block (dir (search getattr open read)))
(allow onyx_daemon sysfs_devices_block (file (read write getattr open ioctl lock map)))
(allow onyx_daemon sysfs_memory (dir (search getattr open read)))
(allow onyx_daemon sysfs_memory (file (read write getattr open ioctl lock map)))
(allow onyx_daemon sysfs_ged (dir (search getattr open read)))
(allow onyx_daemon sysfs_ged (file (read write getattr open ioctl lock map)))
(allow onyx_daemon sysfs_mali_power_policy (dir (search getattr open read)))
(allow onyx_daemon sysfs_mali_power_policy (file (read write getattr open ioctl lock map)))
(allow onyx_daemon sysfs_therm (dir (search getattr open read)))
(allow onyx_daemon sysfs_therm (file (read write getattr open ioctl lock map)))
(allow onyx_daemon sysfs_usb_supply (dir (search getattr open read)))
(allow onyx_daemon sysfs_usb_supply (file (read write getattr open ioctl lock map)))
(allow onyx_daemon sysfs_battery_supply (dir (search getattr open read)))
(allow onyx_daemon sysfs_battery_supply (file (read write getattr open ioctl lock map)))
(allow onyx_daemon sysfs_zram (dir (search getattr open read)))
(allow onyx_daemon sysfs_zram (file (read write getattr open ioctl lock map)))
(allow onyx_daemon sysfs_fs_f2fs (dir (search getattr open read)))
(allow onyx_daemon sysfs_fs_f2fs (file (read write getattr open ioctl lock map)))
(allow onyx_daemon sysfs_blockio (dir (search getattr open read)))
(allow onyx_daemon sysfs_blockio (file (read write getattr open ioctl lock map)))
; Screen-state detection has a framework power-service fallback. Do not grant
; coredomain access to generic LED files, forbidden by the stock platform.
(allow onyx_daemon vendor_sysfs_displayfeature (dir (search getattr open read)))
(allow onyx_daemon vendor_sysfs_displayfeature (file (read getattr open ioctl lock map)))
(allow onyx_daemon proc_powerhal_cpu_ctrl (file (read write getattr open ioctl lock map)))
(allow onyx_daemon proc_touch_boost (file (read write getattr open ioctl lock map)))
(allow onyx_daemon proc_tp_file (file (read getattr open ioctl lock map)))
(allow onyx_daemon proc_swappiness (file (read write getattr open ioctl lock map)))
(allow onyx_daemon proc_drop_caches (file (write open getattr)))
(allow onyx_daemon input_device (chr_file (read write getattr open ioctl lock map)))
(allow onyx_daemon swap_block_device (blk_file (read write getattr open ioctl lock map)))
(allow onyx_daemon sysfs_onyx_mali_devfreq (dir (search getattr open read)))
(allow onyx_daemon sysfs_onyx_mali_devfreq (file (read write getattr open ioctl lock map)))
(allow onyx_daemon sysfs_onyx_touch (dir (search getattr open read)))
(allow onyx_daemon sysfs_onyx_touch (file (read write getattr open ioctl lock map)))
(genfscon sysfs "/devices/platform/soc/13000000.mali/devfreq/13000000.mali" (u object_r sysfs_onyx_mali_devfreq ((s0) (s0))))
(genfscon sysfs "/devices/platform/13000000.mali/devfreq/13000000.mali" (u object_r sysfs_onyx_mali_devfreq ((s0) (s0))))
(genfscon sysfs "/devices/platform/goodix_ts.0" (u object_r sysfs_onyx_touch ((s0) (s0))))

; Subsystem metadata is read-only; requests are confined to min_freq/max_freq.
(allow onyx_daemon sysfs_onyx_subsystem (dir (search getattr open read)))
(allow onyx_daemon sysfs_onyx_subsystem (file (read getattr open)))
(allow onyx_daemon sysfs_onyx_subsystem_floor (file (read write getattr open)))
; Preserve the target ROM's RAM parent label and existing controller access.
(allow onyx_daemon sysfs_dvfsrc_devfreq (dir (search getattr open read)))
(allow onyx_daemon sysfs_dvfsrc_devfreq (file (read getattr open)))
(allow mtk_hal_power sysfs_onyx_subsystem (dir (ioctl read getattr lock open watch watch_reads search)))
(allow mtk_hal_power sysfs_onyx_subsystem (file (ioctl read write getattr lock append map open watch watch_reads)))
(allow mtk_hal_power sysfs_onyx_subsystem_floor (file (ioctl read write getattr lock append map open watch watch_reads)))
(genfscon sysfs "/devices/platform/soc/1c00f000.dvfsrc/mtk-dvfsrc-devfreq/devfreq/mtk-dvfsrc-devfreq/min_freq" (u object_r sysfs_onyx_subsystem_floor ((s0) (s0))))
(genfscon sysfs "/devices/platform/soc/1c00f000.dvfsrc/mtk-dvfsrc-devfreq/devfreq/mtk-dvfsrc-devfreq/max_freq" (u object_r sysfs_onyx_subsystem_floor ((s0) (s0))))
(genfscon sysfs "/devices/platform/soc/112b0000.ufshci/devfreq/112b0000.ufshci" (u object_r sysfs_onyx_subsystem ((s0) (s0))))
(genfscon sysfs "/devices/platform/soc/112b0000.ufshci/devfreq/112b0000.ufshci/min_freq" (u object_r sysfs_onyx_subsystem_floor ((s0) (s0))))
(genfscon sysfs "/devices/platform/soc/112b0000.ufshci/devfreq/112b0000.ufshci/max_freq" (u object_r sysfs_onyx_subsystem_floor ((s0) (s0))))

; Xiaomi vendor services and narrowly scoped native THP timing access.
(allow onyx_daemon vendor_hal_displayfeature_xiaomi_service (service_manager (find)))
(allow onyx_daemon vendor_hal_displayfeature_xiaomi_default (binder (call transfer)))
(allow vendor_hal_displayfeature_xiaomi_default onyx_daemon (binder (transfer)))
(allow onyx_daemon vendor_hal_displayfeature_xiaomi_default (fd (use)))
(allow onyx_daemon hal_touchfeature_xiaomi_service (service_manager (find)))
(allow onyx_daemon hal_touchfeature_xiaomi_default (binder (call transfer)))
(allow hal_touchfeature_xiaomi_default onyx_daemon (binder (transfer)))
(allow onyx_daemon hal_touchfeature_xiaomi_default (fd (use)))
(allow onyx_daemon hal_touchfeature_xiaomi_default (process (ptrace)))
(allow onyx_daemon hal_touchfeature_xiaomi_default (dir (search)))
(allow onyx_daemon hal_touchfeature_xiaomi_default (file (getattr open read write)))
