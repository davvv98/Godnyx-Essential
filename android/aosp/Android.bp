// Onyx Essential prebuilt integration for the product partition.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_app_import {
    name: "OnyxEssential",
    apk: "prebuilt/OnyxEssential.apk",
    presigned: true,
    preprocessed: true,
    product_specific: true,
    required: ["onyx_daemon"],
    dex_preopt: {
        enabled: false,
    },
}

cc_prebuilt_binary {
    name: "onyx_daemon",
    srcs: ["prebuilt/onyx_daemon"],
    compile_multilib: "64",
    product_specific: true,
    shared_libs: [
        "libbinder_ndk",
        "libc",
        "libdl",
    ],
    strip: {
        none: true,
    },
    init_rc: ["onyx_daemon.rc"],
}

cc_prebuilt_binary {
    name: "onyx_ctl",
    srcs: ["prebuilt/onyx_ctl"],
    compile_multilib: "64",
    product_specific: true,
    shared_libs: [
        "libc",
        "libdl",
    ],
    strip: {
        none: true,
    },
}
