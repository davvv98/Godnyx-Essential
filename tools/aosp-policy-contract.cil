(typeattributeset file_type (onyx_daemon_data_release_probe))
(typeattributeset data_file_type (onyx_daemon_data_release_probe))
(typeattributeset core_data_file_type (onyx_daemon_data_release_probe))

(type onyx_mali_devfreq_release_probe)
