(typeattributeset halserverdomain (onyx_display_hal_release_probe))

(type onyx_hal_service_release_probe)
(typeattributeset service_manager_type (onyx_hal_service_release_probe))
(typeattributeset protected_service (onyx_hal_service_release_probe))
(typeattributeset hal_service_type (onyx_hal_service_release_probe))

(allow onyx_daemon_release_probe self (capability
    (dac_override sys_admin sys_nice sys_ptrace)))
(allow onyx_daemon_release_probe self (unix_stream_socket
    (create ioctl read getattr write setattr lock append bind connect listen
     accept getopt setopt shutdown map)))
(allow onyx_daemon_release_probe self (netlink_kobject_uevent_socket
    (create bind read getattr getopt setopt)))

(allow onyx_daemon_release_probe onyx_daemon_data_release_probe
    (dir (add_name create getattr ioctl lock open read remove_name search
          setattr write)))
(allow onyx_daemon_release_probe onyx_daemon_data_release_probe
    (file (append create getattr ioctl lock map open read rename setattr unlink
           write)))

(allow onyx_app_release_probe onyx_daemon_release_probe
    (unix_stream_socket (connectto)))

(allow onyx_daemon_release_probe sysfs (dir (search)))
(allow onyx_daemon_release_probe onyx_mali_devfreq_release_probe (dir (getattr search open read)))
(allow onyx_daemon_release_probe onyx_mali_devfreq_release_probe (file (getattr open read write ioctl lock map)))
(allow onyx_daemon_release_probe onyx_battery_supply_release_probe (file (getattr open read write ioctl lock map)))

(allow onyx_daemon_release_probe onyx_sysfs_rw_release_probe
    (dir (getattr open read search)))
(allow onyx_daemon_release_probe onyx_sysfs_rw_release_probe
    (file (getattr ioctl lock map open read write)))
(allow onyx_daemon_release_probe onyx_proc_rw_release_probe
    (file (getattr ioctl lock map open read write)))
(allow onyx_daemon_release_probe onyx_swap_block_release_probe
    (blk_file (getattr ioctl lock map open read write)))
(allow onyx_daemon_release_probe onyx_input_device_release_probe
    (chr_file (getattr ioctl lock map open read write)))

(allow onyx_daemon_release_probe onyx_touch_hal_release_probe
    (binder (call transfer)))
(allow onyx_touch_hal_release_probe onyx_daemon_release_probe
    (binder (transfer)))
(allow onyx_daemon_release_probe onyx_touch_hal_release_probe (fd (use)))
(allow onyx_daemon_release_probe onyx_touch_hal_release_probe (process (ptrace)))
(allow onyx_daemon_release_probe onyx_touch_hal_release_probe (dir (search)))
(allow onyx_daemon_release_probe onyx_touch_hal_release_probe (file (getattr open read write)))

(allow onyx_daemon_release_probe onyx_display_hal_release_probe
    (binder (call transfer)))
(allow onyx_display_hal_release_probe onyx_daemon_release_probe
    (binder (transfer)))
(allow onyx_daemon_release_probe onyx_display_hal_release_probe (fd (use)))
(allow onyx_daemon_release_probe onyx_hal_service_release_probe
    (service_manager (find)))

(allow onyx_daemon_release_probe system_server (binder (call transfer)))
(allow system_server onyx_daemon_release_probe (binder (transfer)))
(allow onyx_daemon_release_probe system_server (fd (use)))
(allow system_server onyx_daemon_release_probe (fd (use)))
(allow system_server onyx_daemon_release_probe (fifo_file (write)))
(allow onyx_daemon_release_probe display_service (service_manager (find)))
(allow onyx_daemon_release_probe power_service (service_manager (find)))
(allow onyx_daemon_release_probe settings_service (service_manager (find)))
(allow onyx_daemon_release_probe window_service (service_manager (find)))
(allow onyx_daemon_release_probe activity_service (service_manager (find)))
(allow onyx_daemon_release_probe package_service (service_manager (find)))
(allow onyx_daemon_release_probe logd (unix_stream_socket (connectto)))
(allow onyx_daemon_release_probe logdr_socket (sock_file (write)))
(allow onyx_daemon_release_probe overlay_service (service_manager (find)))
(allow onyx_daemon_release_probe system_file
    (file (execute execute_no_trans getattr map open read)))
(allow onyx_daemon_release_probe toolbox_exec
    (file (execute execute_no_trans getattr map open read)))
