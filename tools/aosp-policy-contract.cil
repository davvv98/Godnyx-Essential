(type onyx_daemon_release_probe)
(typeattributeset domain (onyx_daemon_release_probe))
(typeattributeset coredomain (onyx_daemon_release_probe))
(typeattributeset mlstrustedsubject (onyx_daemon_release_probe))
(typeattributeset onyx_native_touch_access (onyx_daemon_release_probe))

